{
  "buildCommand": "npm run build",
  "installCommand": "npm install",
  "outputDirectory": "dist",
  "nodeVersion": "20.18.0",
  "cloudFunctions": {
    "maxDuration": 120
  },
  "rewrites": [
    {
      "source": "/api/*",
      "destination": "/api/:splat"
    },
    {
      "source": "/*",
      "destination": "/index.html"
    }
  ]
}
